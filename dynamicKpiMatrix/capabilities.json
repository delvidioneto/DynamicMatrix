{
    "dataRoles": [
        {
            "displayName": "Categorias",
            "description": "Coluna de dimensão (um nível). Cada valor distinto vira uma linha.",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Valores",
            "description": "Medidas DAX que criam colunas da matriz. Ordem = ordem das colunas.",
            "name": "kpis",
            "kind": "Measure"
        },
        {
            "displayName": "Informações complementares",
            "description": "Medidas auxiliares. Associe até 4 por valor no painel de formatação.",
            "name": "complements",
            "kind": "Measure"
        },
        {
            "displayName": "Ícone da categoria",
            "description": "Opcional: URL ou SVG/data URI por categoria (alternativa a imagens persistidas).",
            "name": "categoryIcon",
            "kind": "Measure"
        },
        {
            "displayName": "Dicas de ferramentas",
            "description": "Medidas extras para o tooltip nativo da coluna de categorias.",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
