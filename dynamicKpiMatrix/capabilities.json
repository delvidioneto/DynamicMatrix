    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "categoryIcon": { "max": 1 },
                    "kpis": { "min": 0, "max": 20 },
                    "complements": { "max": 40 },
                    "tooltips": { "max": 10 }
                }
            ],
            "matrix": {
                "rows": {
                    "for": { "in": "category" },
                    "dataReductionAlgorithm": { "top": { "count": 500 } }
                },
                "values": {
                    "select": [
                        { "for": { "in": "kpis" } },
                        { "for": { "in": "complements" } },
                        { "bind": { "to": "categoryIcon" } },
                        { "for": { "in": "tooltips" } }
                    ]
                }
            }
        }
    ],
    "subtotals": {
        "matrix": {
            "rowSubtotals": {
                "propertyIdentifier": {
                    "objectName": "subTotals",
                    "propertyName": "rowSubtotals"
                },
                "defaultValue": true
            },
            "rowSubtotalsType": {
                "propertyIdentifier": {
                    "objectName": "subTotals",
                    "propertyName": "rowSubtotalsType"
                },
                "defaultValue": "Top"
            }
        }
    },
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": ["tooltips"]
    },
    "privileges": []
